{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024", "DOM", "DOM.AsyncIterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"strict": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["bun"]
	},
	"include": ["index.ts", "index.test.ts", "patch.ts", "patch.test.ts", "projection.ts", "projection.test.ts", "state.ts", "state.test.ts", "branch.ts", "branch.test.ts", "procedure.ts", "procedure.test.ts", "messages.ts", "messages.test.ts", "skill-fixtures.ts", "verification/analyze.ts"]
}
